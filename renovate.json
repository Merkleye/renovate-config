{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScope(deps)"
  ],
  "labels": ["dependencies"],
  "timezone": "America/New_York",
  "schedule": ["before 6am on monday"],
  "lockFileMaintenance": {
    "description": "Refresh transitive deps in package-lock.json, not just the ranges in package.json.",
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "GitHub Actions, non-major. Pinned to SHAs by helpers:pinGitHubActionDigests, so most updates arrive here as digest bumps.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "bump"],
      "groupName": "Actions Minor"
    },
    {
      "description": "GitHub Actions, major -- reviewed separately since these can be breaking.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "Actions Major"
    },
    {
      "description": "mise-managed toolchain pins (mise.toml: node), non-major.",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "bump"],
      "groupName": "Mise Minor"
    },
    {
      "description": "mise-managed toolchain pins, major -- reviewed separately since these can be breaking.",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["major"],
      "groupName": "Mise Major"
    },
    {
      "description": "npm dependencies and devDependencies, non-major.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "bump"],
      "groupName": "NPM Minor"
    },
    {
      "description": "npm dependencies, major -- reviewed separately since these can be breaking.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "groupName": "NPM Major"
    },
    {
      "description": "Container base images (Containerfile, docker-compose*.yml), non-major.",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "bump"],
      "groupName": "Docker Minor"
    },
    {
      "description": "Container base images, major -- reviewed separately since these can be breaking.",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["major"],
      "groupName": "Docker Major"
    },
    {
      "description": "The node pin is duplicated in mise.toml and Containerfile -- bump both in one PR.",
      "matchPackageNames": ["node", "docker.io/library/node"],
      "groupName": "Node toolchain"
    },
    {
      "description": "React runtime and its types must move together.",
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "React"
    },
    {
      "description": "Vite toolchain -- vite, its react plugin, and vitest share a version surface.",
      "matchPackageNames": ["vite", "@vitejs/plugin-react", "vitest"],
      "groupName": "Vite"
    },
    {
      "description": "ESLint stack -- eslint and typescript-eslint break apart.",
      "matchPackageNames": ["eslint", "@eslint/js", "typescript-eslint", "eslint-plugin-react-hooks"],
      "groupName": "ESLint"
    },
    {
      "description": "Tailwind core and its vite plugin are released in lockstep.",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/vite"],
      "groupName": "Tailwind"
    }
  ]
}
